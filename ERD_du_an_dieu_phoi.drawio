        <mxCell id="schema-note" value="M:N được tách thành hai quan hệ 1:N qua các bảng trung gian. Mũi tên đi từ bảng chứa FK đến bảng được tham chiếu. allocation_items là chi tiết phân bổ nối allocation, request_item và donation_item theo số lượng. attachments.owner_type/owner_id và location/reference ID trong supply_movements không có FK trực tiếp. Thông báo không có bảng riêng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="2250" width="3390" height="90" as="geometry" />
        </mxCell>
