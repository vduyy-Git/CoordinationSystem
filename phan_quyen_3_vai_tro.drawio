    <mxCell id="user-auth" value="&lt;b&gt;TÀI KHOẢN &amp;amp; TỔNG QUAN&lt;/b&gt;&lt;br&gt;• Đăng ký, đăng nhập, quên mật khẩu&lt;br&gt;• Xem tổng quan cá nhân&lt;br&gt;• Đăng xuất" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#68A985;fontColor=#173B2A;fontSize=14;" vertex="1" parent="1">
