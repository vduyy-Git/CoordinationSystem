    <mxCell id="coord-review" value="&lt;b&gt;TIẾP NHẬN &amp;amp; DUYỆT&lt;/b&gt;&lt;br&gt;• Duyệt / từ chối yêu cầu hỗ trợ&lt;br&gt;• Duyệt một phần yêu cầu hỗ trợ&lt;br&gt;• Duyệt / từ chối quyên góp" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#6696C8;fontColor=#183A5A;fontSize=14;" vertex="1" parent="1">
