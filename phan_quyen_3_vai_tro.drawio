    <mxCell id="coord-oversight" value="&lt;b&gt;ĐIỀU PHỐI &amp;amp; BÁO CÁO&lt;/b&gt;&lt;br&gt;• Xem tồn kho và dashboard toàn hệ thống&lt;br&gt;• Xem báo cáo tổng hợp, xuất báo cáo&lt;br&gt;• Xem đăng ký dịch vụ xã hội và cập nhật trạng thái" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#6696C8;fontColor=#183A5A;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="606" y="765" width="488" height="155" as="geometry"/>
    </mxCell>
    <mxCell id="coord-data" value="&lt;b&gt;DỮ LIỆU ĐIỀU PHỐI&lt;/b&gt;&lt;br&gt;• Quản lý vật tư, danh mục và số lượng kho&lt;br&gt;• Quản lý điểm tập kết, đối tác vận chuyển&lt;br&gt;• Quản lý dữ liệu nghiệp vụ liên quan" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#6696C8;fontColor=#183A5A;fontSize=14;" vertex="1" parent="1">
