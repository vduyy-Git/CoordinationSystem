    <mxCell id="user-request" value="&lt;b&gt;YÊU CẦU HỖ TRỢ &amp;amp; QUYÊN GÓP&lt;/b&gt;&lt;br&gt;• Tạo yêu cầu hỗ trợ và trao tặng vật tư&lt;br&gt;• Theo dõi yêu cầu / quyên góp của mình&lt;br&gt;• Hủy khi trạng thái còn cho phép" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#68A985;fontColor=#173B2A;fontSize=14;" vertex="1" parent="1">
